#+#+#+#+--------------------------------------------------------------------
# Environment file layering (no more editing `.env` every time)
#
# The app supports comma-separated ENV_FILE to load multiple env files.
# OS environment variables still win over any file.
#
# Examples:
#   Local dev:   ENV_FILE=.env,.env.local
#   Docker-like: ENV_FILE=.env,.env.docker
#
# Note: `.env` / `.env.local` / `.env.docker` are intended to be local-only.
# Commit `.env.example` (this file) and optionally `.env.docker.example`.
ENV_FILE=

LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
GROQ_MAX_TOKENS=

# Demo mode model (Groq)
# If set, unauthenticated demo traffic will be restricted to this model.
# Leave blank to use GROQ_MODEL.
# Recommended for fast interactive demo UX:
#   meta-llama/llama-4-maverick-17b
GROQ_DEMO_MODEL=
# Platform-controlled key used for unauthenticated demo mode (strictly rate-limited)
STRATAX_DEMO_API_KEY=

# If provided, the backend will rotate keys automatically and cooldown exhausted ones.
STRATAX_DEMO_API_KEYS=[]
# IMPORTANT:
# - In production/staging, set ENABLE_DEMO_KEY_POOL=true so public demo traffic uses the demo pool.
# - In local development, you typically want your UI testing to use your developer/server key
#   (GROQ_API_KEY / GEMINI_API_KEY) and NOT consume demo keys.
ENABLE_DEMO_KEY_POOL=false
# Safety: even if ENABLE_DEMO_KEY_POOL=true, demo pool is blocked in development/local unless
# you explicitly opt in.
ALLOW_DEMO_KEY_POOL_IN_DEV=false
# Optional: hard global demo budget guard (daily request cap). 0 disables.
DEMO_GLOBAL_DAILY_REQUEST_LIMIT=0
OPENAI_API_KEY=
COHERE_API_KEY=

# ----------------------------- App / Runtime keys ---------------------------
API_KEY=
SERPER_API_KEY=
JUDGE0_API_KEY=
# Optional override for the RapidAPI Host header used for Judge0.
# Leave as default unless you know you need to change it.
JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
GITHUB_TOKEN=

# Feature flags (true/false)
ENABLE_HYBRID_SEARCH=true
ENABLE_RERANKING=true
ENABLE_CODE_EXECUTION=true
ENABLE_QUERY_EXPANSION=true
ENABLE_STREAMING=true

# API Key Policy
# Set to 'true' to require users to provide their own API keys (server keys won't be used as fallback)
# Set to 'false' (default) to allow server API keys as fallback when user doesn't provide one
REQUIRE_USER_API_KEY=false

# App settings
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Docker note: this repo's Dockerfile runs Uvicorn on port 7860 by default.
# Local dev commonly uses 8000.

# Multi-worker (primarily for containers / production; keep 1 with --reload)
UVICORN_WORKERS=1

# URLs (used for OAuth redirect URIs)
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8080

# Google OAuth (Login with Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mermaid rendering
# Optional: point to a local Kroki instance to avoid external dependencies.
# Example (docker-compose): http://kroki:8000/mermaid/svg
# Example (local machine): http://localhost:8001/mermaid/svg
KROKI_URL=

# Optional: override vector DB / storage paths when mounting volumes
DATA_DIR=/app/data

# ----------------------------- Persistence (DB) -----------------------------
# SQLite default (works everywhere):
#   DATABASE_URL=sqlite:///./data/stratax.db
# Postgres example (local):
#   DATABASE_URL=postgresql+psycopg://stratax:stratax@localhost:5432/stratax
DATABASE_URL=

# Storage overrides (auto|db|file)
# - auto: use DB when DATABASE_URL is Postgres; otherwise file storage
# - db:   force DB-backed repositories
# - file: force filesystem JSON/JSONL storage
STRATAX_SESSION_STORE=auto
STRATAX_HISTORY_STORE=auto

# ----------------------------- Vector DB (Qdrant) ---------------------------
# If QDRANT_URL is set, Interview Intelligence uses Qdrant as a service.
# This is REQUIRED for multi-worker deployments.
# Example (local):  http://localhost:6333
# Example (compose): http://qdrant:6333
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=interview_questions

# --------------------------- Redis (shared state) ----------------------------
# If set, the backend will use Redis for:
# - distributed rate limiting (safe with multiple Uvicorn workers)
# - selected shared caches (e.g., Mermaid diagram SVGs)
#
# Local example:
#   REDIS_URL=redis://localhost:6379/0
# Docker-compose example:
#   REDIS_URL=redis://redis:6379/0
REDIS_URL=
REDIS_KEY_PREFIX=stratax
# If true (default), Redis outages won't take down the API (rate limit fails open).
REDIS_FAIL_OPEN=true
# TTL for shared caches (seconds)
REDIS_CACHE_TTL_SECONDS=3600

# Notes:
# - Fill the values in your local `.env` (not here). Keep secrets out of Git.
# - For production, store secrets in a secret manager or use Docker/K8s secrets.
