# Docker / production-like overrides (template)
#
# Copy to `.env.docker` if you want an override file for compose/prod-like runs.
# Note: `.env.docker` is ignored by git by default.

# In docker-compose, QDRANT_URL is usually injected as http://qdrant:6333
# Keep this blank unless you want to override.
QDRANT_URL=
QDRANT_COLLECTION_NAME=interview_questions

# Multi-worker default for containers
UVICORN_WORKERS=2

# Redis (distributed rate limiting + shared caches)
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=stratax
REDIS_FAIL_OPEN=true
REDIS_CACHE_TTL_SECONDS=3600

# Demo mode (unauthenticated users with no keys)
# Recommended for interactive UI latency:
GROQ_DEMO_MODEL=meta-llama/llama-4-maverick-17b
